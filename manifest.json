{
  "manifest_version": 3,
  "name": "Bob Ghost Tutor — Live Web Inspector",
  "version": "3.0.5",
  "description": "Bob Project Mentor: consent-based, contextual project guidance and release-readiness planning.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://github.com/*",
        "https://gist.github.com/*"
      ],
      "js": [
        "shield.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://github.com/*",
        "https://gist.github.com/*"
      ],
      "js": [
        "engine.js",
        "bridge.js",
        "ghost.js",
        "project-model.js",
        "bob.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
