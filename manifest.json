{
  "manifest_version": 3,
  "name": "Bob — Universal AI Project Mentor",
  "version": "3.1.2",
  "description": "A consent-based project mentor: understand, plan, verify, release and maintain your actual product.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://github.com/*",
        "https://gist.github.com/*"
      ],
      "js": [
        "shield.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://github.com/*",
        "https://gist.github.com/*"
      ],
      "js": [
        "privacy.js",
        "engine.js",
        "bridge.js",
        "conversation.js",
        "project-model.js",
        "readiness-planner.js",
        "requirements.js",
        "verification.js",
        "project-store.js",
        "model-reasoner.js",
        "bob.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
